/* Dark theme for Settings Interface */
QWidget {
    background-color: #202020;
    color: #ffffff;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Settings group styling */
QGroupBox {
    color: #ffffff;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    margin: 15px 0px 0px 0px;
    padding-top: 15px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0px 10px 0px 10px;
    color: #ffffff;
}

/* Settings card styling */
QFrame[objectName="settingCard"] {
    background-color: #2d2d30;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 12px;
}

QFrame[objectName="settingCard"]:hover {
    background-color: #383838;
    border-color: #505050;
}